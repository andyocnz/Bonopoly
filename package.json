{
  "name": "bonopoly-react2",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "tsx watch src/server/index.ts",
    "dev:all": "concurrently \"npm run server\" \"npm run dev\"",
    "build": "prisma generate && tsc -b && vite build",
    "build-serverless": "node build-serverless.js",
    "vercel-build": "prisma generate && prisma db push --accept-data-loss && npm run build-serverless && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "simulate:test": "tsx simulation-test/simulate.ts",
    "simulate:quick": "tsx simulation-test/simulate.ts --rounds=2 --teams=3",
    "test:snapshot": "tsx scripts/test-config-snapshot.ts",
    "test:cleanup": "tsx scripts/cleanup-test-games.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@types/bcryptjs": "^2.4.6",
    "@xyflow/react": "^12.10.1",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "prisma": "^5.22.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.11.0",
    "recharts": "^3.5.1",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "esbuild": "^0.27.2",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4"
  }
}
